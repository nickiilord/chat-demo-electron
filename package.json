{
  "name": "chat",
  "version": "0.3.0",
  "description": "基于 DeepSeek API 的跨平台聊天应用。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.cjs",
  "author": "nickiilord",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "type:electron": "tsc -p electron/tsconfig.json",
    "start": "electron .",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "pack:dir": "electron-builder --dir --publish never --config electron-builder.yml",
    "dist": "electron-builder --publish never --config electron-builder.yml",
    "dist:win": "electron-builder --win --publish never --config electron-builder.yml",
    "dist:mac": "electron-builder --mac --publish never --config electron-builder.yml",
    "dist:linux": "electron-builder --linux --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "~1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
